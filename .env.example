# Media Critic — Next.js static export (GitHub Pages) + Supabase
# Dashboard: https://supabase.com/dashboard/project/<YOUR_PROJECT_REF>

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub Pages project site path (must match repo name). Leave empty for local `npm run dev`.
# Example: NEXT_PUBLIC_BASE_PATH=/MEDIA-CRITIC
NEXT_PUBLIC_BASE_PATH=

# Never put service_role, DB passwords, or SEND_EMAIL_HOOK_SECRET here.
